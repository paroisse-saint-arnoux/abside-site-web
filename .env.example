APP_NAME="L'Abside"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://abside-culture.fr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Europe/Paris

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
CACHE_STORE=file
# Pas de worker sur l'hébergement mutualisé : tout est synchrone.
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Brevo SMTP (transactionnel) — https://app.brevo.com/settings/keys/smtp
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Expéditeur sur le domaine du site (authentifié chez Brevo : SPF/DKIM). Les réponses vont à CONTACT_EMAIL.
MAIL_FROM_ADDRESS="contact@abside-culture.fr"
MAIL_FROM_NAME="${APP_NAME}"

# Brevo API (newsletter)
BREVO_API_KEY=
BREVO_LIST_ID=

# Adresse qui reçoit les messages du formulaire de contact et les alertes d'inscription
CONTACT_EMAIL=abside.association@gmail.com

# Cloudflare Turnstile (anti-spam) — laisser vide pour désactiver
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Matomo (statistiques, sans cookie : pas de bandeau de consentement)
MATOMO_URL=https://matomo.saint-arnoux.fr/
MATOMO_SITE_ID=4
# Clé d'API Matomo (Matomo > Paramètres personnels > Sécurité > Jetons d'authentification), droit « vue » sur le site.
# Sert aux statistiques du tableau de bord de l'admin.
MATOMO_TOKEN=

# Premier administrateur créé par les migrations s'il n'existe aucun utilisateur
ADMIN_EMAIL=
